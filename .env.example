# Copy to .env.local (git-ignored) and fill in. Never commit .env.local.
# The same variables go into the Vercel project settings for the deployment.

# Google Books: required in production, or the site shares the anonymous quota,
# which is exhausted most of the time. Use a separate key for development
# (ROADMAP 0.2) so that a working session cannot spend the production quota.
GOOGLE_BOOKS_API_KEY=

# Absolute origin of the deployment, for canonical URLs, the sitemap and the
# Open Graph image. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Operating mode (PLAN-2-mvp-hobby, SPEC E20). Unset or "hobby": affiliate
# variables are ignored, no availability check, no commission wording.
# "shop": everything on. Only "hobby" may run in production until Phase 4.
NEXT_PUBLIC_SITE_MODE=hobby

# Blurb in the work panel: editions (default; Open Library's work description only as a fallback), work (always Open Library), off
BLURB_SOURCE=

# Legal notice (Impressum, § 18 Abs. 1 MStV / § 5 DDG) and privacy notice.
# Read on the server only; rendered on /contact and /privacy. All four are
# required for a build in production. The address must be one where post can
# be served (no PO box); a c/o address with authority to receive is allowed
# (docs/recht-hobbyseite.md §2.2).
IMPRINT_NAME=
IMPRINT_STREET=
IMPRINT_CITY=
IMPRINT_EMAIL=

# Affiliate parameters, per market. Ignored unless NEXT_PUBLIC_SITE_MODE=shop.
AFFILIATE_AMAZON_TAG_US=
AFFILIATE_AMAZON_TAG_UK=
AFFILIATE_AMAZON_TAG_DE=
AFFILIATE_BOOKSHOP_ID_US=
AFFILIATE_BOOKSHOP_ID_UK=

# Suggestions for collections from friends (ROADMAP 5.10a, SPEC F8.4). Without
# SUGGEST_PASSWORD, /suggest and its routes answer 404. The admin password is
# only for the local tool in lab/collections (SUGGEST_REMOTE=<site>); it must
# differ from the friends' one. Suggestions go to the STORAGE_ Redis.
SUGGEST_PASSWORD=
SUGGEST_ADMIN_PASSWORD=

# Readers' own walls (ROADMAP 5.13a, SPEC F9). "on" or "off"; unset means on
# everywhere except Vercel production. Uses the cover game's STORAGE_ Redis.
WALLS=

# Photo import on /walls (SPEC F9.4): the image model reads a shelf photo.
# Without it the page says photos are off (and offers a sample outside production).
ANTHROPIC_API_KEY=

# Mail to Julian when a reader's collection is reported (SPEC F9.9). Provided by the
# Resend integration from the Vercel Marketplace. Without it no mail is sent; each
# report is then only a `bb.walls.report` log line and a row on /create/review.
RESEND_API_KEY=
# Recipient; the imprint address when unset. Sender defaults to onboarding@resend.dev.
WALLS_REPORT_TO=
WALLS_REPORT_FROM=

# Optional sign-in for readers' collections (ROADMAP 5.13h, SPEC F9.11, E23).
# "on" or "off"; unset means on everywhere except Vercel production, and only
# where WALLS is on. Without the secret (>= 32 characters) no button shows;
# a provider without its credentials shows no button either. Redirect URLs to
# register: <origin>/api/walls/signin/<google|apple|facebook>/callback
# (setup in docs/plans/PLAN-5.13-wand-funnel.md, "Anmelden einrichten").
WALLS_SIGNIN=
WALLS_SIGNIN_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Apple: the Services ID, team, key id and the .p8 key's contents (\n allowed).
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
